{
  "name": "fullstack-prep-journal",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,client -c green,cyan \"npm:dev:server\" \"npm:dev:client\"",
    "dev:client": "vite --host 0.0.0.0",
    "dev:server": "tsx watch server/src/index.ts",
    "build": "npm run typecheck && vite build && tsc -p server/tsconfig.json",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview --host 0.0.0.0",
    "deploy": "gh-pages -d dist"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@types/canvas-confetti": "^1.9.0",
    "@vitejs/plugin-react": "^5.1.1",
    "canvas-confetti": "^1.9.4",
    "concurrently": "^9.2.1",
    "cors": "^2.8.5",
    "dompurify": "^3.3.1",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "framer-motion": "^12.42.2",
    "highlight.js": "^11.11.1",
    "lucide-react": "^0.562.0",
    "marked": "^17.0.1",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-is": "^19.2.8",
    "react-router-dom": "^6.30.4",
    "recharts": "^3.10.1",
    "tailwindcss": "^3.4.19",
    "zod": "^4.2.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^25.0.3",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "gh-pages": "^6.3.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.0"
  }
}
